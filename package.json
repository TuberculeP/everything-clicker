{
  "name": "everything-clicker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon server/src/main.ts",
    "build": "tsc -p server && vite build",
    "start": "cross-env NODE_ENV=production node dist/main.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "lint:webapp": "eslint webapp",
    "lint:server": "eslint server",
    "dockerize": "docker compose -f docker-compose.yml -f docker-compose.local.yml up --build --force-recreate -d",
    "migration:generate": "node server/scripts/migration-generate.mjs",
    "migration:run": "cross-env TS_NODE_PROJECT=server/tsconfig.json typeorm-ts-node-commonjs migration:run -d server/src/config/db.config.ts",
    "migration:revert": "cross-env TS_NODE_PROJECT=server/tsconfig.json typeorm-ts-node-commonjs migration:revert -d server/src/config/db.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.60.0",
    "@vueuse/components": "^13.2.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.560.0",
    "pg": "^8.13.0",
    "pinia": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.6.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1",
    "typeorm": "^0.3.22",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "xp.css": "^0.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.89.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^6.0.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.0"
  }
}
