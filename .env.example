# Environnement d'execution (development | production)
NODE_ENV=development

# Base de donnees Postgres (optionnel en dev - fallback SQLite si absent)
# En local avec `npm run dockerize`, le port 5432 est publie : localhost marche.
POSTGRES_URL=postgres://user:password@localhost:5432/mydatabase

# Identifiants du conteneur Postgres (docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase

# Compte de connexion pgAdmin (docker-compose)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
